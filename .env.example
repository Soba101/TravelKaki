# Copy this file to `.env` and fill in the values.  `.env` is git-ignored.

# Required. Get it from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=

# Optional. Your own cloud LLM key (Claude / OpenAI). Only needed for non-Ollama models.
LLM_API_KEY=

# Optional. Google Maps/Places key for better geocoding. Without it we use OpenStreetMap.
GOOGLE_MAPS_API_KEY=

# Optional. true = allow video download for better place extraction. Off by default (platform ToS).
VIDEO_FETCH=false

# Optional. false = start only the web API, no Telegram bot (handy for testing).
RUN_BOT=true

# ---- M1: saving places from links ----

# Optional. Where the SQLite database lives (./data is a Docker volume).
DATABASE_URL=sqlite:///data/travelkaki.db

# Optional. LLM that reads captions. Default: local Ollama model (free, no key).
EXTRACT_MODEL=ollama_chat/qwen3:4b-instruct

# Optional. Cloud model tried once if the local one fails, e.g. anthropic/claude-haiku-4-5.
# Needs LLM_API_KEY. Leave empty for no fallback.
EXTRACT_FALLBACK_MODEL=

# Optional. How the container reaches Ollama on your computer (Docker Desktop default).
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Optional. Max LLM calls per trip per day.
LLM_DAILY_CAP=100

# Optional. Your email for OpenStreetMap's geocoder (their usage policy asks for one).
NOMINATIM_EMAIL=

# ---- M2: the planner agent (/plan) ----

# Optional. LLM that runs the planner. Needs tool calling. Default: local Ollama model.
PLAN_MODEL=ollama_chat/qwen3:4b-instruct

# Optional. Cloud model tried once per round if the local one fails. Needs LLM_API_KEY.
PLAN_FALLBACK_MODEL=

# M3: mini app direct link from BotFather (/newapp), no query string. Empty = no map button.
MINI_APP_URL=
