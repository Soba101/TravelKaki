# Copy this file to `.env` and fill in the values.  `.env` is git-ignored.

# Required. Get it from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=

# Optional (used from M1). Your own LLM key, e.g. Claude or OpenAI. Leave empty to use Ollama.
LLM_API_KEY=

# Optional. Google Maps/Places key for better geocoding. Without it we use OpenStreetMap.
GOOGLE_MAPS_API_KEY=

# Optional. true = allow video download for better place extraction. Off by default (platform ToS).
VIDEO_FETCH=false

# Optional. false = start only the web API, no Telegram bot (handy for testing).
RUN_BOT=true
